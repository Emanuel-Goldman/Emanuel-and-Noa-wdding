rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /uploads/{fileName} {
      allow read: if true;
      allow create: if isValidUpload();
      allow update: if false;

      // DELIBERATE, KNOWN RISK: see the matching note in firestore.rules.
      // Scoped to uploads/ only — the catch-all below still denies everything
      // else in the bucket.
      allow delete: if true;

      function isValidUpload() {
        return request.resource.size <= 300 * 1024 * 1024
          && request.resource.contentType.matches('(image|video)/.*');
      }
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
