rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /uploads/{fileName} {
      allow read: if true;
      allow create: if isValidUpload();
      allow update: if false;

      // DELIBERATE, KNOWN RISK: see the matching note in firestore.rules.
      // Scoped to uploads/ only — the catch-all below still denies everything
      // else in the bucket.
      allow delete: if true;

      function isValidUpload() {
        return request.resource.size <= 300 * 1024 * 1024
          && request.resource.contentType.matches('(image|video)/.*');
      }
    }

    // Client-generated gallery-grid thumbnails: small downscaled JPEGs
    // uploaded alongside the original in uploads/{fileName}, never the source
    // of truth. Same deliberate open-delete risk as uploads/ above.
    match /uploads/thumbs/{fileName} {
      allow read: if true;
      allow create: if isValidThumbnailUpload();
      allow update: if false;
      allow delete: if true;

      function isValidThumbnailUpload() {
        return request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      }
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
